        <mxCell id="s5" value="&lt;font style='font-size:16px'&gt;&lt;b&gt;⑤ POST-PROCESS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;Fuse object, split on contour&lt;br&gt;Morphology: opening · fill holes&lt;br&gt;→ separated instances" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=center;verticalAlign=middle;arcSize=8;shadow=1;" vertex="1" parent="1">
