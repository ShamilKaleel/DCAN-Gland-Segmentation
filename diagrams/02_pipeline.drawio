        </mxCell>

        <mxCell id="s1" value="&lt;font style='font-size:16px'&gt;&lt;b&gt;① INPUT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;H&amp;E histology image&lt;br&gt;+ ground-truth labels (training)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;verticalAlign=middle;arcSize=8;shadow=1;" vertex="1" parent="1">
