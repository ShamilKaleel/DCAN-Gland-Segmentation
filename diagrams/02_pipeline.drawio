<mxfile host="app.diagrams.net" type="device">
  <diagram name="End-to-end pipeline" id="pipeline">
    <mxGraphModel dx="1140" dy="620" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1140" pageHeight="620" math="0" shadow="0">
      <root>
