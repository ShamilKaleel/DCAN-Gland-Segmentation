<mxfile host="app.diagrams.net" type="device">
  <diagram name="Contour fusion mechanism" id="fusion">
    <mxGraphModel dx="1300" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Why the contour branch matters — separating touching glands by fusion" style="text;html=1;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="260" y="20" width="1000" height="32" as="geometry" />
        </mxCell>

        <!-- input with two touching glands -->
        <mxCell id="inbox" value="Two touching&#10;glands (H&amp;E)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="290" width="200" height="160" as="geometry" />
        </mxCell>
        <mxCell id="g1" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#cfe2c4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="70" y="360" width="75" height="65" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#cfe2c4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="130" y="360" width="75" height="65" as="geometry" />
        </mxCell>

        <!-- object branch -->
        <mxCell id="pobj" value="&lt;b&gt;OBJECT branch → p_obj&lt;/b&gt;&lt;br&gt;&lt;br&gt;foreground ≈ 1 over BOTH glands&lt;br&gt;→ one merged blob" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;verticalAlign=top;spacingTop=10;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="150" width="320" height="130" as="geometry" />
        </mxCell>

        <!-- contour branch -->
        <mxCell id="pcnt" value="&lt;b&gt;CONTOUR branch → p_cnt&lt;/b&gt;&lt;br&gt;&lt;br&gt;high on the shared boundary&lt;br&gt;ridge between the glands" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;verticalAlign=top;spacingTop=10;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="460" width="320" height="130" as="geometry" />
        </mxCell>

        <!-- fusion -->
        <mxCell id="fuse" value="&lt;b&gt;FUSION&lt;/b&gt;&lt;br&gt;&lt;br&gt;mask = (p_obj ≥ t_o)&lt;br&gt;AND (p_cnt &lt; t_c)&lt;br&gt;&lt;br&gt;the contour ridge is subtracted,&lt;br&gt;carving the seam between glands" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="680" y="290" width="290" height="160" as="geometry" />
        </mxCell>

        <!-- result -->
        <mxCell id="result" value="Two separated&#10;components" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1030" y="290" width="210" height="160" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#9ac27e;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1055" y="365" width="70" height="65" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#7fb3e0;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1150" y="365" width="70" height="65" as="geometry" />
        </mxCell>

        <!-- ccl -->
        <mxCell id="ccl" value="&lt;b&gt;Connected components&lt;/b&gt;&lt;br&gt;+ remove small&lt;br&gt;&lt;br&gt;→ 2 instances ✓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1300" y="290" width="200" height="160" as="geometry" />
        </mxCell>

        <!-- edges -->
        <mxCell id="ei1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=1;exitY=0.3;entryX=0;entryY=0.6;" edge="1" parent="1" source="inbox" target="pobj"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ei2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=1;exitY=0.7;entryX=0;entryY=0.4;" edge="1" parent="1" source="inbox" target="pcnt"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ef1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="pobj" target="fuse"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ef2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.7;" edge="1" parent="1" source="pcnt" target="fuse"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="efr" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="fuse" target="result"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="erc" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="result" target="ccl"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- contrast + code -->
        <mxCell id="fcn" value="✗  FCN baseline (object only): threshold p_obj alone → the merged blob stays merged → counted as ONE gland. This is the false-merge failure that DCAN’s contour branch fixes." style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=2;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="300" y="620" width="1200" height="56" as="geometry" />
        </mxCell>
        <mxCell id="codemap" value="Code: contour target → src/dcan/data/targets.py:instance_to_contour_mask   ·   fusion → src/dcan/postprocess.py:fuse_predictions + postprocess_mask" style="text;html=1;fontSize=14;align=left;fontColor=#777777;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="1440" height="26" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
